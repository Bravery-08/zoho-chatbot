# backend/zoho_mcp/.env.example
# Add these to your existing backend/.env (do NOT commit real values).

# The MCP server URL from the Zoho MCP console. Include the full path.
# Mind the trailing slash — see README "Common gotchas".
ZOHO_MCP_URL=https://<your-server>.zoho.in/mcp

# Simplest auth: a bearer token. Confirm the exact mechanism in the console.
ZOHO_MCP_AUTH_TOKEN=

# Optional extra headers, e.g. "X-Org-Id:1234;X-Foo:bar"
ZOHO_MCP_EXTRA_HEADERS=

# Optional connection timeout (seconds)
ZOHO_MCP_TIMEOUT=30

# Reused from the main app (already in your .env): GROQ_API_KEY, MODEL_NAME.
# Override the model used by the agent/eval if you want to test a different one:
ZOHO_AGENT_MODEL=llama-3.3-70b-versatile

# Optional: set to your Groq per-1M-token rates to get a cost column in the report.
PRICE_PER_MTOK_INPUT=0
PRICE_PER_MTOK_OUTPUT=0
